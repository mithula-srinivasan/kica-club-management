# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, these go in the service's Environment settings instead.

# "production" only on Render. Leave as "development" on your Mac.
APP_ENV=development

# Your Mac's database (Render gives its own URL)
DATABASE_URL=postgresql+psycopg:///kica_club_management

# Where the React app runs (on Render: https://kicachess.com)
FRONTEND_URL=http://localhost:5173

# Gmail account that sends reset emails, and its 16-character app password.
# Optional on your Mac (emails are printed instead), required on Render.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=